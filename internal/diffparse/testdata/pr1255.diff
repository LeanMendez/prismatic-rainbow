+package com.atlassian.maven.plugins.amps.util;
+
+import static java.nio.file.LinkOption.NOFOLLOW_LINKS;
+import static java.nio.file.StandardOpenOption.CREATE;
+import static java.nio.file.StandardOpenOption.TRUNCATE_EXISTING;
+import static java.nio.file.StandardOpenOption.WRITE;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.file.FileAlreadyExistsException;
+import java.nio.file.Files;
+import java.nio.file.InvalidPathException;
+import java.nio.file.NoSuchFileException;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributes;
+
+/**
+ * Confines file system writes to a root directory, guarding against path traversal.
+ *
+ * <p>Paths are first checked lexically: an untrusted relative path must not be absolute on the current platform, or use
+ * {@code ..} segments to escape the root. On Windows, "absolute" also covers drive-relative paths such as
+ * {@code C:foo}, rooted paths such as {@code \foo} and UNC paths; elsewhere, those are just unusual file names. Then,
+ * when directories and files are created, every path component below the root is checked without following links: an
+ * existing symbolic link (or Windows junction) or a non-directory in the way causes the write to be refused, rather
+ * than followed to wherever it points.
+ *
+ * <p>The root itself is trusted, and may be (or sit below) a symbolic link.
+ *
+ * <p>The checks happen just before each component is used. A concurrent process able to modify the tree under the root
+ * at the same time could still race them, so callers should only write into directories that untrusted users cannot
+ * modify.
+ *
+ * @since 9.14
+ */
+public final class PathConfinement {
+
+    private PathConfinement() {}
+
+    /**
+     * Resolves an untrusted relative path against the given root, without touching the file system.
+     *
+     * @param root the trusted root directory
+     * @param untrustedPath the relative path, e.g. an archive entry name; may contain {@code ..} segments as long as
+     *     they don't escape the root. A leading {@code ~} is not expanded, i.e. it's just a directory name
+     * @return the normalised, absolute target, guaranteed to be the root or one of its descendants
+     * @throws IOException if the path is not relative on the current platform, is not a valid path, or escapes the root
+     */
+    public static Path resolve(final Path root, final String untrustedPath) throws IOException {
+        final Path relative;
+        try {
+            relative = root.getFileSystem().getPath(untrustedPath);
+        } catch (InvalidPathException e) {
+            throw new IOException(String.format("'%s' is not a valid path: %s", untrustedPath, e.getMessage()), e);
+        }
+        if (relative.getRoot() != null) {
+            // Not just isAbsolute(), which is false for Windows paths such as "C:foo" and "\foo" that still escape
+            throw new IOException(String.format("'%s' is an absolute path", untrustedPath));
+        }
+        return requireWithin(root, root.resolve(relative));
+    }
+
+    /**
+     * Checks lexically that the given target is the root or one of its descendants, without touching the file system.
+     *
+     * @param root the trusted root directory
+     * @param target the target path; relative paths are resolved against the working directory
+     * @return the normalised, absolute target
+     * @throws IOException if the target is outside the root
+     */
+    public static Path requireWithin(final Path root, final Path target) throws IOException {
+        final Path normalisedRoot = normalise(root);
+        final Path normalisedTarget = normalise(target);
+        if (!normalisedTarget.startsWith(normalisedRoot)) {
+            throw new IOException(
+                    String.format("'%s' is outside the target directory '%s'", normalisedTarget, normalisedRoot));
+        }
+        return normalisedTarget;
+    }
+
+    /**
+     * Validates a directory and its existing ancestors below the trusted root without creating anything. Missing
+     * directories are allowed, but existing symbolic links, junctions and non-directories below the root are not. This
+     * is a preflight check, not a reservation: callers must still check paths when performing the write.
+     *
+     * @return the normalised, absolute directory
+     * @throws IOException if the directory escapes the root or an existing path component is unsuitable
+     */
+    public static Path validateDirectory(final Path root, final Path directory) throws IOException {
+        final Path normalisedRoot = normalise(root);
+        final Path normalisedDirectory = requireWithin(normalisedRoot, directory);
+        // The root is trusted and may be a link, but must resolve to a directory if it exists.
+        if (Files.exists(normalisedRoot, NOFOLLOW_LINKS) && !Files.isDirectory(normalisedRoot)) {
+            throw new IOException(String.format("'%s' is not a directory", normalisedRoot));
+        }
+        Path current = normalisedRoot;
+        for (final Path name : normalisedRoot.relativize(normalisedDirectory)) {
+            if (name.toString().isEmpty()) {
+                continue;
+            }
+            current = current.resolve(name);
+            final BasicFileAttributes attributes = readAttributesIfExists(current);
+            if (attributes == null) {
+                break; // Descendants cannot exist below a missing directory.
+            }
+            requireRealDirectory(current, attributes);
+        }
+        return normalisedDirectory;
+    }
+
+    /**
