+import org.junit.jupiter.api.condition.EnabledOnOs;
+import org.junit.jupiter.api.condition.OS;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class PathConfinementTest {
+
+    @TempDir
+    Path tempDir;
+
+    private Path root;
+    private Path outside;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        root = Files.createDirectories(tempDir.resolve("root"));
+        outside = Files.createDirectories(tempDir.resolve("outside"));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"/etc/passwd", "//server/share"})
+    void resolveRejectsAbsolutePaths(final String path) {
+        final IOException e = assertThrows(IOException.class, () -> PathConfinement.resolve(root, path));
+        assertThat(e.getMessage(), containsString("absolute path"));
+    }
+
+    @ParameterizedTest
+    @EnabledOnOs(OS.WINDOWS)
+    @ValueSource(strings = {"\\etc\\passwd", "\\\\server\\share\\file", "C:", "c:\\x", "C:x", "a:b.txt"})
+    void resolveRejectsWindowsAbsolutePathsOnWindows(final String path) {
+        assertThrows(IOException.class, () -> PathConfinement.resolve(root, path));
+    }
+
+    @ParameterizedTest
+    @DisabledOnOs(OS.WINDOWS)
+    @ValueSource(strings = {"a:b.txt", "C:x", "\\etc\\passwd", "..\\x"})
+    void resolveAcceptsNamesThatAreOnlyAbsoluteOnWindowsElsewhere(final String path) throws IOException {
+        assertEquals(root.resolve(path).toAbsolutePath(), PathConfinement.resolve(root, path));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"file.txt", "a/b/c.txt", "..hidden", "~"})
+    void resolveAcceptsRelativePaths(final String path) throws IOException {
+        assertEquals(root.resolve(path).toAbsolutePath(), PathConfinement.resolve(root, path));
+    }
+
+    @Test
+    void resolveDoesNotExpandTilde() throws IOException {
+        assertEquals(root.resolve("~").resolve("path").toAbsolutePath(), PathConfinement.resolve(root, "~/path"));
+    }
+
+    @Test
+    void resolveNormalisesContainedParentSegments() throws IOException {
+        assertEquals(root.resolve("b").toAbsolutePath(), PathConfinement.resolve(root, "a/../b"));
+    }
+
+    @Test
+    void resolveOfEmptyPathIsRoot() throws IOException {
+        assertEquals(root.toAbsolutePath(), PathConfinement.resolve(root, ""));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"..", "../outside/file", "a/../../outside", "../root-sibling/file"})
+    void resolveRejectsEscapingPaths(final String path) {
+        final IOException e = assertThrows(IOException.class, () -> PathConfinement.resolve(root, path));
+        assertThat(e.getMessage(), containsString("outside the target directory"));
+    }
+
+    @Test
+    void requireWithinRejectsSiblingWithSamePrefix() {
+        assertThrows(
+                IOException.class,
+                () -> PathConfinement.requireWithin(
+                        root, tempDir.resolve("root-sibling").resolve("file")));
+    }
+
+    @Test
+    void validationDoesNotCreateMissingRootOrDirectories() throws IOException {
+        final Path missingRoot = tempDir.resolve("missing-root");
+
+        PathConfinement.validateDirectory(missingRoot, missingRoot.resolve("a/b"));
+        PathConfinement.validateFile(missingRoot, missingRoot.resolve("a/b/file.txt"));
+
+        assertFalse(Files.exists(missingRoot));
+    }
+
+    @Test
+    void validateFilePreservesExistingContent() throws IOException {
+        final Path file = Files.writeString(root.resolve("file.txt"), "original");
+
+        PathConfinement.validateFile(root, file);
+
+        assertEquals("original", Files.readString(file));
+    }
+
+    @Test
+    void validationRejectsExistingFileWhereDirectoryIsRequired() throws IOException {
+        final Path file = Files.writeString(root.resolve("file.txt"), "original");
+
+        assertThrows(IOException.class, () -> PathConfinement.validateDirectory(root, file));
+        assertThrows(IOException.class, () -> PathConfinement.validateFile(root, file.resolve("nested.txt")));
+
+        assertEquals("original", Files.readString(file));
+    }
+
+    @Test
+    void validateFileRejectsDanglingSymlink() throws IOException {
+        final Path missingTarget = outside.resolve("missing.txt");
+        final Path link = root.resolve("link");
+        createSymlinkOrSkip(link, missingTarget);
+
+        assertThrows(IOException.class, () -> PathConfinement.validateFile(root, link));
+
+        assertFalse(Files.exists(missingTarget));
+        assertTrue(Files.isSymbolicLink(link));
+    }
+
+    @Test
+    void validationAllowsTrustedSymlinkRootWithoutCreatingDescendants() throws IOException {
+        final Path linkedRoot = tempDir.resolve("linked-root");
+        createSymlinkOrSkip(linkedRoot, outside);
+
+        PathConfinement.validateDirectory(linkedRoot, linkedRoot.resolve("nested"));
+        PathConfinement.validateFile(linkedRoot, linkedRoot.resolve("nested/file.txt"));
+
+        assertFalse(Files.exists(outside.resolve("nested")));
+    }
+
+    @Test
+    void createDirectoriesCreatesNestedDirectoriesAndRoot() throws IOException {
+        final Path newRoot = tempDir.resolve("new-root");
+
+        PathConfinement.createDirectories(newRoot, newRoot.resolve("a/b/c"));
+
+        assertTrue(Files.isDirectory(newRoot.resolve("a/b/c")));
+    }
+
+    @Test
+    void createDirectoriesRejectsSymlinkedComponent() throws IOException {
+        createSymlinkOrSkip(root.resolve("link"), outside);
+
+        final IOException e = assertThrows(
+                IOException.class, () -> PathConfinement.createDirectories(root, root.resolve("link/nested")));
+
+        assertThat(e.getMessage(), containsString("symbolic link"));
+        assertFalse(Files.exists(outside.resolve("nested")));
+    }
+
+    @Test
+    void createDirectoriesRejectsFileComponent() throws IOException {
+        Files.write(root.resolve("file"), new byte[0]);
+
+        final IOException e = assertThrows(
+                IOException.class, () -> PathConfinement.createDirectories(root, root.resolve("file/nested")));
+
+        assertThat(e.getMessage(), containsString("not a directory"));
+    }
+
+    @Test
+    void createDirectoriesAllowsRootBelowSymlink() throws IOException {
+        final Path linkedRoot = tempDir.resolve("linked-root");
+        createSymlinkOrSkip(linkedRoot, outside);
+
+        PathConfinement.createDirectories(linkedRoot, linkedRoot.resolve("nested"));
+
+        assertTrue(Files.isDirectory(outside.resolve("nested")));
+    }
+
+    @Test
+    void newOutputStreamWritesAndTruncatesFile() throws IOException {
+        final Path file = root.resolve("a/file.txt");
+        write(file, "a longer original content");
+
+        write(file, "new");
+
+        assertEquals("new", new String(Files.readAllBytes(file), UTF_8));
+    }
+
+    @Test
+    void newOutputStreamRejectsSymlinkedFile() throws IOException {
+        final Path victim = Files.write(outside.resolve("victim.txt"), "original".getBytes(UTF_8));
+        createSymlinkOrSkip(root.resolve("file.txt"), victim);
+
+        final IOException e = assertThrows(IOException.class, () -> write(root.resolve("file.txt"), "evil"));
+
+        assertThat(e.getMessage(), containsString("symbolic link"));
+        assertEquals("original", new String(Files.readAllBytes(victim), UTF_8));
+    }
+
+    @Test
+    void newOutputStreamRejectsFileOutsideRoot() {
+        assertThrows(IOException.class, () -> write(outside.resolve("file.txt"), "evil"));
+
+        assertFalse(Files.exists(outside.resolve("file.txt")));
+    }
+
+    @Test
+    void newOutputStreamRejectsRootItself() {
+        final IOException e = assertThrows(IOException.class, () -> write(root, "evil"));
+
+        assertThat(e.getMessage(), containsString("target directory itself"));
+    }
+
+    @Test
+    void newOutputStreamRejectsExistingDirectory() throws IOException {
+        Files.createDirectories(root.resolve("dir"));
+
+        final IOException e = assertThrows(IOException.class, () -> write(root.resolve("dir"), "evil"));
+
+        assertThat(e.getMessage(), containsString("a directory"));
+    }
+
+    private void write(final Path file, final String content) throws IOException {
+        try (OutputStream out = PathConfinement.newOutputStream(root, file)) {
+            out.write(content.getBytes(UTF_8));
+        }
+    }
+
+    private static void createSymlinkOrSkip(final Path link, final Path target) {
+        try {
+            Files.createSymbolicLink(link, target);
+        } catch (IOException | UnsupportedOperationException e) {
+            assumeTrue(false, "Symbolic links are not supported on this platform");
+        }
+    }
+}
