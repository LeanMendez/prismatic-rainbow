+        }
+    }
+
+    private static void requireRealDirectory(final Path path) throws IOException {
+        requireRealDirectory(path, Files.readAttributes(path, BasicFileAttributes.class, NOFOLLOW_LINKS));
+    }
+
+    private static void requireRealDirectory(final Path path, final BasicFileAttributes attributes) throws IOException {
+        if (attributes.isSymbolicLink() || attributes.isOther()) {
+            // On Windows, junctions are reported as "other", not as symbolic links
+            throw new IOException(String.format("'%s' is a symbolic link or junction; refusing to follow it", path));
+        }
+        if (!attributes.isDirectory()) {
