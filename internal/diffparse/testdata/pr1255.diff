+        }
+    }
+
+    private static String describeNonRegularFile(final BasicFileAttributes attributes) {
+        if (attributes.isSymbolicLink() || attributes.isOther()) {
+            return "a symbolic link, junction or special file; refusing to follow it";
+        }
+        return attributes.isDirectory() ? "a directory" : "not a regular file";
+    }
+
+    private static Path normalise(final Path path) {
+        return path.toAbsolutePath().normalize();
+    }
+}
