+package com.atlassian.maven.plugins.amps.transform.executor.xmltojava;
+
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import com.google.common.collect.ImmutableMap;
+
+class TemplateUtilTest {
+
+    private static final String TEMPLATE = "SpringXml.sub";
+
+    @TempDir
+    Path tempDir;
+
+    @ParameterizedTest
+    @ValueSource(
+            strings = {
+                "",
+                ".",
+                "..",
+                "/com/atlassian/maven/plugins/amps/transform/executor/xmltojava/SpringXml.sub",
+                "../SpringXml.sub",
+                "nested/SpringXml.sub",
+                "..\\SpringXml.sub"
+            })
+    void getProcessedTemplateRejectsNonSimpleNames(final String template) {
+        assertThrows(
+                IllegalArgumentException.class, () -> TemplateUtil.getProcessedTemplate(template, ImmutableMap.of()));
+    }
+
+    @Test
+    void writeTemplateToPathWritesProcessedTemplate() throws IOException {
+        final Path file = tempDir.resolve("META-INF/spring/spring.xml");
+
+        TemplateUtil.writeTemplateToPath(
+                tempDir, file, TEMPLATE, ImmutableMap.of("qualifiedClassName", "com.example.Beans"));
+
+        assertThat(new String(Files.readAllBytes(file), UTF_8), containsString("com.example.Beans"));
+    }
+
+    @Test
+    void writeTemplateToPathRejectsFileOutsideRoot() throws IOException {
+        final Path root = Files.createDirectories(tempDir.resolve("root"));
+        final Path outsideFile = tempDir.resolve("outside.xml");
+
+        assertThrows(
+                IOException.class,
+                () -> TemplateUtil.writeTemplateToPath(root, outsideFile, TEMPLATE, ImmutableMap.of()));
+
+        assertFalse(Files.exists(outsideFile));
+    }
+
+    @Test
+    void writeTemplateToPathRefusesToWriteThroughSymlink() throws IOException {
+        final Path root = Files.createDirectories(tempDir.resolve("root"));
+        final Path victim = Files.write(tempDir.resolve("victim.txt"), "original".getBytes(UTF_8));
+        final Path link = root.resolve("spring.xml");
+        try {
+            Files.createSymbolicLink(link, victim);
+        } catch (IOException | UnsupportedOperationException e) {
+            assumeTrue(false, "Symbolic links are not supported on this platform");
+        }
+
+        assertThrows(
+                IOException.class, () -> TemplateUtil.writeTemplateToPath(root, link, TEMPLATE, ImmutableMap.of()));
+
+        assertEquals("original", new String(Files.readAllBytes(victim), UTF_8));
+    }
+}
