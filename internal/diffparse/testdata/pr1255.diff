+    private File createZip(final String name, final String entryName) throws IOException {
+        return createZip(name, zipEntry(entryName, 0, entryName));
+    }
+
+    private File createZip(final String name, final ZipArchiveEntryWithContent... entries) throws IOException {
+        final File zipFile = new File(tempDir, name);
+        try (ZipArchiveOutputStream out = new ZipArchiveOutputStream(zipFile)) {
+            for (final ZipArchiveEntryWithContent entry : entries) {
+                out.putArchiveEntry(entry.entry);
+                out.write(entry.content);
+                out.closeArchiveEntry();
+            }
+        }
+        return zipFile;
+    }
+
+    private static ZipArchiveEntryWithContent zipEntry(final String name, final int unixMode, final String content) {
+        final ZipArchiveEntry entry = new ZipArchiveEntry(name);
+        if (unixMode != 0) {
+            entry.setUnixMode(unixMode);
+        }
+        return new ZipArchiveEntryWithContent(entry, content.getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static final class ZipArchiveEntryWithContent {
+        final ZipArchiveEntry entry;
+        final byte[] content;
+
+        ZipArchiveEntryWithContent(final ZipArchiveEntry entry, final byte[] content) {
+            this.entry = entry;
+            this.content = content;
+        }
+    }
+
+    private File createTarGz(final String name, final String entryName) throws IOException {
+        return createTarGz(name, tarFile(entryName));
+    }
+
+    private File createTarGz(final String name, final TarArchiveEntry... entries) throws IOException {
+        final File targz = new File(tempDir, name);
+        try (OutputStream fileOut = Files.newOutputStream(targz.toPath());
+                GzipCompressorOutputStream gzOut = new GzipCompressorOutputStream(fileOut);
+                TarArchiveOutputStream tarOut = new TarArchiveOutputStream(gzOut)) {
+            for (final TarArchiveEntry entry : entries) {
+                tarOut.putArchiveEntry(entry);
+                if (entry.getSize() > 0) {
+                    // Regular files contain their own name; links have no content
+                    tarOut.write(entry.getName().getBytes(StandardCharsets.UTF_8));
+                }
+                tarOut.closeArchiveEntry();
+            }
+        }
+        return targz;
+    }
+
+    private static TarArchiveEntry tarFile(final String entryName) {
+        // Preserve absolute paths and drive letters, so that malicious names reach ZipUtils as-is
+        final TarArchiveEntry entry = new TarArchiveEntry(entryName, true);
+        entry.setSize(entryName.getBytes(StandardCharsets.UTF_8).length);
+        return entry;
+    }
+
+    private static TarArchiveEntry tarLink(final String entryName, final byte linkFlag, final String linkName) {
+        final TarArchiveEntry entry = new TarArchiveEntry(entryName, linkFlag);
+        entry.setLinkName(linkName);
+        return entry;
+    }
+
+    private static void createSymlinkOrSkip(final File link, final File target) {
+        try {
+            Files.createSymbolicLink(link.toPath(), target.toPath());
+        } catch (IOException | UnsupportedOperationException e) {
+            assumeTrue(false, "Symbolic links are not supported on this platform");
+        }
+    }
